{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"phi-code": ["./packages/coding-agent/src/index.ts"],
			"@phi-code-admin/phi-code": ["./packages/coding-agent/src/index.ts"],
			"@phi-code-admin/phi-code/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@phi-code-admin/phi-code/*": ["./packages/coding-agent/src/*"],
			"phi-code-ai": ["./packages/ai/src/index.ts"],
			"phi-code-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"phi-code-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"phi-code-ai/dist/*": ["./packages/ai/src/*"],
			"phi-code-agent": ["./packages/agent/src/index.ts"],
			"phi-code-agent/*": ["./packages/agent/src/*"],
			"phi-code-tui": ["./packages/tui/src/index.ts"],
			"phi-code-tui/*": ["./packages/tui/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@mariozechner/pi-web-ui": ["./packages/web-ui/src/index.ts"],
			"@mariozechner/pi-web-ui/*": ["./packages/web-ui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": [
		"packages/web-ui/**/*",
		"packages/mom/**/*",
		"packages/pods/**/*",
		"packages/camoufox-js/**/*",
		"packages/camofox-browser/**/*",
		"packages/camoufox-bin-*/**/*",
		"packages/browser/**/*",
		"**/dist/**"
	]
}
