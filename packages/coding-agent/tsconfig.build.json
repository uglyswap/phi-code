{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"phi-code-agent": ["../agent/dist/index.d.ts"],
			"phi-code-agent/*": ["../agent/dist/*.d.ts"],
			"phi-code-ai": ["../ai/dist/index.d.ts"],
			"phi-code-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"phi-code-client": ["../client/dist/index.d.ts"],
			"phi-code-protocol": ["../protocol/dist/index.d.ts"],
			"phi-code-tui": ["../tui/dist/index.d.ts"],
			"phi-code-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
