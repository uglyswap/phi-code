{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"phi-code": [
				"./src/index.ts"
			],
			"@phi-code-admin/phi-code": [
				"./src/index.ts"
			],
			"@phi-code-admin/phi-code/hooks": [
				"./src/core/hooks/index.ts"
			],
			"@phi-code-admin/phi-code/*": [
				"./src/*"
			],
			"phi-code-tui": [
				"../tui/src/index.ts"
			],
			"phi-code-tui/*": [
				"../tui/src/*"
			],
			"phi-code-ai": [
				"../ai/src/index.ts"
			],
			"phi-code-ai/oauth": [
				"../ai/src/oauth.ts"
			],
			"phi-code-ai/*": [
				"../ai/src/*.ts",
				"../ai/src/providers/*.ts"
			],
			"phi-code-agent": [
				"../agent/src/index.ts"
			],
			"phi-code-agent/*": [
				"../agent/src/*"
			],
			"phi-code-protocol": [
				"../protocol/src/index.ts"
			],
			"phi-code-protocol/*": [
				"../protocol/src/*"
			],
			"phi-code-client": [
				"../client/src/index.ts"
			],
			"phi-code-client/*": [
				"../client/src/*"
			],
			"phi-code-telemetry": [
				"../telemetry/src/index.ts"
			],
			"@phi-code-admin/browser": [
				"../browser/src/index.ts"
			],
			"typebox": [
				"../../node_modules/typebox"
			]
		},
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true
	},
	"include": [
		"extensions/phi/**/*.ts",
		"src/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	],
	"_note": "Typecheck for phi extensions (NOT covered by tsconfig.build, loaded via jiti at runtime). @phi-code-admin/browser maps to its sources so browser.ts typechecks without building packages/browser. sigma-memory (memory.ts) resolves through its published dist/*.d.ts via node_modules (no source mapping): rebuild packages/sigma-memory after changing its API; run check:ext before changing the orchestrator or adding commands."
}
